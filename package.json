  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
